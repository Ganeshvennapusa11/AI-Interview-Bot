# ---------- Core (required) ----------
MONGO_URI=
JWT_SECRET=
GROQ_API_KEY=
PORT=5000

# Optional: pin one Groq model. Leave unset to auto-select the first that works.
# Run `npm run check:groq` to list the models this key can access.
# GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Frontend ----------
# Used to build password-reset links and welcome emails.
FRONTEND_URL=http://localhost:5173
# Extra comma-separated origins allowed by CORS in production.
# FRONTEND_URLS=https://your-app.vercel.app

# ---------- Email (required for forgot-password) ----------
# Without these the API silently skips sending and no reset link ever arrives.
# Gmail needs an App Password (Google Account > Security > App passwords), not your login password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM="Interview Companion" <you@gmail.com>
APP_NAME=Interview Companion

# Note: VITE_* keys belong in client/.env only - they are bundled into the browser build.
